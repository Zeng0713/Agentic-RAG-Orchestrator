SILICONFLOW_API_KEY=your_siliconflow_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key

# Optional local runtime settings
CHROMA_DB_PATH=./chroma_db
UPLOADS_DIR=data/uploads
MAX_UPLOAD_SIZE_MB=5
MAX_QUESTION_LENGTH=2000
CHAT_REQUESTS_PER_MINUTE=20
CHAT_IP_REQUESTS_PER_MINUTE=60
UPLOADS_PER_MINUTE=5

# Web state backends: memory (no Redis required) or redis
SESSION_BACKEND=memory
RATE_LIMIT_BACKEND=memory
# Required if either backend is redis; no URL query parameters supported
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=rag
SESSION_TTL_SECONDS=86400
SESSION_LOCK_LEASE_SECONDS=60
SESSION_LOCK_RENEW_SECONDS=15
CHAT_DEADLINE_SECONDS=300
